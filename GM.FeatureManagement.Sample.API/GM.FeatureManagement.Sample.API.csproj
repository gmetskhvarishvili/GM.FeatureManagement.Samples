<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <!--
      References the sibling source repo by project path so it builds against current code. Once the
      package is published, swap for:
        <PackageReference Include="GM.FeatureManagement" Version="1.0.0" />
        <PackageReference Include="GM.Caching"           Version="1.0.0" />
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\GM.FeatureManagement\GM.FeatureManagement\GM.FeatureManagement.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="GM.Caching" Version="1.0.0" />
        <PackageReference Include="GM.Caching.Redis" Version="1.0.0" />
    </ItemGroup>

</Project>
