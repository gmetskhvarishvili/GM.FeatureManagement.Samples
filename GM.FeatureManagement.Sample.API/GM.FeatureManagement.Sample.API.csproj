<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <!--
      Published-package references — the shape the sample ships in once the GM.FeatureManagement
      packages are live on nuget.org (isolated CI restores them normally). For local development
      against the sibling source repo, use the ProjectReference form on the feat/featuremanagement-sample
      branch instead.
    -->
    <ItemGroup>
        <PackageReference Include="GM.FeatureManagement" Version="1.0.0" />
        <PackageReference Include="GM.FeatureManagement.AspNetCore" Version="1.0.0" />
        <PackageReference Include="GM.Caching" Version="1.0.0" />
        <PackageReference Include="GM.Caching.Redis" Version="1.0.0" />
    </ItemGroup>

</Project>
